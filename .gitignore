# Approved initial upload scope; new top-level files need explicit review.
/*
!/.gitignore
!/README.md
!/SOURCES.md
!/requirements.txt
!/requirements-lock.txt
!/src/
!/tests/
!/literature/
!/notes/
!/results/

/notes/*
!/notes/ssh_theory.md
!/notes/ssh_topology_assumptions.md
!/notes/ssh_topology_expectations.md
!/notes/ssh_topology_learning.md
!/notes/agent_evaluation_public.md

/results/*
!/results/README.md
!/results/ssh_bands_run02/
!/results/ssh_topology_run02/
!/results/logs/
/results/logs/*
!/results/logs/ssh_bands_pytest_run01.txt
!/results/logs/ssh_topology_pytest_run02.txt

# Local environments, caches, backups and private configuration.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.matplotlib/
.local-private/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials*.json
secrets*.json
.vscode/
.idea/
Thumbs.db
.DS_Store
